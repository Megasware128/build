From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Copilot <223556219+Copilot@users.noreply.github.com>
Date: Sun, 24 May 2026 00:00:00 +0000
Subject: [PATCH] arm64: dts: amlogic: s7d: add clkc DT node

Add the S7D clock controller node into the apb bus so peripheral
nodes can reference &clkc phandles. The driver is added in patch
0051; this hooks it up in the device tree.

Signed-off-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
diff --git a/arch/arm64/boot/dts/amlogic/amlogic-s7d.dtsi b/arch/arm64/boot/dts/amlogic/amlogic-s7d.dtsi
--- a/arch/arm64/boot/dts/amlogic/amlogic-s7d.dtsi
+++ b/arch/arm64/boot/dts/amlogic/amlogic-s7d.dtsi
@@ -90,6 +90,14 @@
 #size-cells = <2>;
 ranges = <0x0 0x0 0x0 0xfe000000 0x0 0x480000>;
 
+clkc: clock-controller@0 {
+compatible = "amlogic,s7d-clkc";
+reg = <0x0 0x0 0x0 0x10000>;
+clocks = <&xtal>;
+clock-names = "xtal";
+#clock-cells = <1>;
+};
+
 uart_b: serial@7a000 {
 compatible = "amlogic,s7d-uart",
      "amlogic,meson-s4-uart";
