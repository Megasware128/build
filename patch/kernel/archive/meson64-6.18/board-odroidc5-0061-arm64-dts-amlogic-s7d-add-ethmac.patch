From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Copilot <223556219+Copilot@users.noreply.github.com>
Date: Mon, 25 May 2026 01:06:22 +0200
Subject: [PATCH 2/2] arm64: dts: amlogic: s7d: add Ethernet MAC

Add the S7D DesignWare Ethernet MAC using the BSP register map: MAC at 0xfe368000, PRG_ETH at 0xfe364000, and GIC SPI 74.

Signed-off-by: Copilot <223556219+Copilot@users.noreply.github.com>

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-s7d.dtsi b/arch/arm64/boot/dts/amlogic/amlogic-s7d.dtsi
index 57579a6ab1a1..ee87a40de40c 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-s7d.dtsi
+++ b/arch/arm64/boot/dts/amlogic/amlogic-s7d.dtsi
@@ -3,6 +3,7 @@
  * Copyright (c) 2025 Amlogic, Inc. All rights reserved.
  */
 
+#include <dt-bindings/clock/amlogic,s7d-clkc.h>
 #include <dt-bindings/interrupt-controller/irq.h>
 #include <dt-bindings/interrupt-controller/arm-gic.h>
 #include <dt-bindings/gpio/gpio.h>
@@ -104,6 +105,31 @@ reset: reset-controller@2000 {
 				#reset-cells = <1>;
 			};
 
+			ethmac: ethernet@368000 {
+				compatible = "amlogic,s7d-eth-dwmac",
+					     "snps,dwmac-4.00";
+				reg = <0x0 0x368000 0x0 0x12ec>,
+				      <0x0 0x364000 0x0 0x8>;
+				interrupts = <GIC_SPI 74 IRQ_TYPE_LEVEL_HIGH>;
+				interrupt-names = "macirq";
+				clocks = <&clkc CLKID_ETH_RMII>,
+					 <&clkc CLKID_FCLK_DIV2>,
+					 <&xtal>;
+				clock-names = "stmmaceth", "clkin0", "clkin1";
+				pinctrl-0 = <&eth_rgmii_pins>;
+				pinctrl-names = "default";
+				phy-mode = "rgmii";
+				rx-fifo-depth = <4096>;
+				tx-fifo-depth = <2048>;
+				status = "disabled";
+
+				mdio0: mdio {
+					compatible = "snps,dwmac-mdio";
+					#address-cells = <1>;
+					#size-cells = <0>;
+				};
+			};
+
 			periphs_pinctrl: pinctrl@4000 {
 				compatible = "amlogic,pinctrl-s7d",
 					     "amlogic,pinctrl-s7";
