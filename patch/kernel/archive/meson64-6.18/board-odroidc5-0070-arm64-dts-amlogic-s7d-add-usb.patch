From 4990479d477f6151da00f544ea58f811f28683b2 Mon Sep 17 00:00:00 2001
From: Copilot <223556219+Copilot@users.noreply.github.com>
Date: Mon, 25 May 2026 01:07:51 +0200
Subject: [PATCH] arm64: dts: amlogic: s7d: add USB PHY and DWC3 nodes

Add the S7D USB2/USB3 PHY register blocks from the BSP dtsi and describe the host controller with the existing Meson G12A DWC3 glue compatible.

Signed-off-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 arch/arm64/boot/dts/amlogic/amlogic-s7d.dtsi | 79 ++++++++++++++++++++
 1 file changed, 79 insertions(+)

diff --git a/arch/arm64/boot/dts/amlogic/amlogic-s7d.dtsi b/arch/arm64/boot/dts/amlogic/amlogic-s7d.dtsi
index 57579a6ab..c4a2c11ea 100644
--- a/arch/arm64/boot/dts/amlogic/amlogic-s7d.dtsi
+++ b/arch/arm64/boot/dts/amlogic/amlogic-s7d.dtsi
@@ -5,7 +5,9 @@
 
 #include <dt-bindings/interrupt-controller/irq.h>
 #include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/clock/amlogic,s7d-clkc.h>
 #include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/phy/phy.h>
 #include <dt-bindings/pinctrl/amlogic,pinctrl.h>
 #include "amlogic-s7d-reset.h"
 
@@ -218,6 +220,83 @@ eth_rgmii_pins: group-eth-rgmii-pins {
 					};
 				};
 			};
+
+			clkc: clock-controller@0 {
+				compatible = "amlogic,s7d-clkc";
+				reg = <0x0 0x0 0x0 0x10000>;
+				clocks = <&xtal>;
+				clock-names = "xtal";
+				#clock-cells = <1>;
+			};
+
+			usb2_phy0: phy@35c000 {
+				compatible = "amlogic,g12a-usb2-phy";
+				reg = <0x0 0x35c000 0x0 0x60>;
+				clocks = <&xtal>;
+				clock-names = "xtal";
+				resets = <&reset RESET_USBPHY20>;
+				reset-names = "phy";
+				#phy-cells = <0>;
+			};
+
+			usb2_phy1: phy@34c000 {
+				compatible = "amlogic,g12a-usb2-phy";
+				reg = <0x0 0x34c000 0x0 0x60>;
+				clocks = <&xtal>;
+				clock-names = "xtal";
+				resets = <&reset RESET_USBPHY21>;
+				reset-names = "phy";
+				#phy-cells = <0>;
+			};
+
+			usb3_phy0: phy@358080 {
+				compatible = "amlogic,g12a-usb3-pcie-phy";
+				reg = <0x0 0x358080 0x0 0x20>;
+				clocks = <&clkc CLKID_SYS_USB>;
+				clock-names = "ref_clk";
+				resets = <&reset RESET_USB0_COMB>;
+				reset-names = "phy";
+				#phy-cells = <1>;
+			};
+
+			usb3_phy1: phy@348080 {
+				compatible = "amlogic,g12a-usb3-pcie-phy";
+				reg = <0x0 0x348080 0x0 0x20>;
+				clocks = <&clkc CLKID_SYS_USB>;
+				clock-names = "ref_clk";
+				resets = <&reset RESET_USB1_COMB>;
+				reset-names = "phy";
+				#phy-cells = <1>;
+			};
+
+			usb: usb@340000 {
+				compatible = "amlogic,meson-g12a-usb-ctrl";
+				reg = <0x0 0x340000 0x0 0xa0>;
+				interrupts = <GIC_SPI 130 IRQ_TYPE_LEVEL_HIGH>;
+				#address-cells = <2>;
+				#size-cells = <2>;
+				ranges;
+
+				clocks = <&clkc CLKID_SYS_USB>;
+				resets = <&reset RESET_USB1>;
+
+				dr_mode = "host";
+
+				phys = <&usb2_phy0>, <&usb2_phy1>,
+				       <&usb3_phy1 PHY_TYPE_USB3>;
+				phy-names = "usb2-phy0", "usb2-phy1", "usb3-phy0";
+
+				dwc3: usb@340000 {
+					compatible = "snps,dwc3";
+					reg = <0x0 0x340000 0x0 0x8000>;
+					interrupts = <GIC_SPI 130 IRQ_TYPE_LEVEL_HIGH>;
+					dr_mode = "host";
+					snps,dis_u2_susphy_quirk;
+					snps,quirk-frame-length-adjustment = <0x20>;
+					snps,parkmode-disable-ss-quirk;
+				};
+			};
+
 		};
 	};
 };
-- 
2.43.0

