+#define CLKID_FCLK_DIV5        5
+#define CLKID_FCLK_DIV7        6
+#define CLKID_FCLK_DIV2P5      7
+#define CLKID_SYS_CLK          8
+#define CLKID_GP0_PLL_DCO      9
+#define CLKID_GP0_PLL          10
+#define CLKID_SD_EMMC_A_SEL    11
+#define CLKID_SD_EMMC_A_DIV    12
+#define CLKID_SD_EMMC_A        13
+#define CLKID_SD_EMMC_B_SEL    14
