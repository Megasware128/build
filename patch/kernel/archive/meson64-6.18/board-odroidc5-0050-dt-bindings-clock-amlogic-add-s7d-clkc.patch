From df90524fbf324b5d45f3963e26bca8105f633a27 Mon Sep 17 00:00:00 2001
From: Copilot <223556219+Copilot@users.noreply.github.com>
Date: Mon, 25 May 2026 00:53:22 +0200
Subject: [PATCH] dt-bindings: clock: amlogic: add S7D clock controller

Signed-off-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 .../bindings/clock/amlogic,s7d-clkc.yaml      | 49 +++++++++++++++++++
 include/dt-bindings/clock/amlogic,s7d-clkc.h  | 41 ++++++++++++++++
 2 files changed, 90 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/clock/amlogic,s7d-clkc.yaml
 create mode 100644 include/dt-bindings/clock/amlogic,s7d-clkc.h

diff --git a/Documentation/devicetree/bindings/clock/amlogic,s7d-clkc.yaml b/Documentation/devicetree/bindings/clock/amlogic,s7d-clkc.yaml
new file mode 100644
index 0000000..951ca60
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/amlogic,s7d-clkc.yaml
@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/amlogic,s7d-clkc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Amlogic S7D Clock Controller
+
+maintainers:
+  - Neil Armstrong <neil.armstrong@linaro.org>
+
+properties:
+  compatible:
+    const: amlogic,s7d-clkc
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    items:
+      - const: xtal
+
+  "#clock-cells":
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - "#clock-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/amlogic,s7d-clkc.h>
+
+    clkc: clock-controller@fe000000 {
+        compatible = "amlogic,s7d-clkc";
+        reg = <0xfe000000 0x10000>;
+        clocks = <&xtal>;
+        clock-names = "xtal";
+        #clock-cells = <1>;
+    };
+...
diff --git a/include/dt-bindings/clock/amlogic,s7d-clkc.h b/include/dt-bindings/clock/amlogic,s7d-clkc.h
new file mode 100644
index 0000000..913c48c
--- /dev/null
+++ b/include/dt-bindings/clock/amlogic,s7d-clkc.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR MIT) */
+/*
+ * Copyright (c) 2026
+ * Author: Copilot <223556219+Copilot@users.noreply.github.com>
