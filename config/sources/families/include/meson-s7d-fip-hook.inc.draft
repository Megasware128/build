# DRAFT — not yet wired in. Source this from meson-s7d.conf only after Phase 1 confirms FIP flow is needed.
# Template based on existing meson64_common.inc `uboot_g12_postprocess` pattern.
# Reference: https://github.com/armbian/build/blob/main/config/sources/families/include/meson64_common.inc

function post_uboot_custom_postprocess__odroidc5_amlogic_fip() {
    display_alert "Packaging Amlogic FIP for ODROID-C5" "$BOARD" "info"

    # Hardkernel odroidc5-v2023.01 is a firmware superproject:
    # - BL33 U-Boot: bl33/v2023, defconfig s7d_odroidc5_defconfig
    # - FIP tooling: ./mk -> fip/mk_script.sh
    # - Vendored blobs/tools: bl2/bin/s7d/s905x5m, bl31/bl31_2.7/bin/s7d/s905x5m,
    #   bl32/bl32_3.18/bin/s7d/s905x5m, bl40/bin/s7d/s905x5m,
    #   soc/templates/s7d/s905x5m, fip/s7d/aml_encrypt_s7d, fip/s7d/binary-tool/acpu-imagetool.
    # Validated partial flow:
    #   cd "${BOOTSOURCEDIR}"
    #   git submodule update --init --recursive
    #   ARCH=arm64 CROSS_COMPILE="${CROSS_COMPILE:-aarch64-linux-gnu-}" ./mk s7d_odroidc5 --disable-bl33z
    # Expected final flashable artifact after successful FIP packaging: build/u-boot.bin.
    # Current blocker: BL30 is built from the RTOS SDK and requires cmake plus the SDK
    # compiler environment (scripts/env.sh / likely RISC-V toolchain) or a matching prebuilt bl30.bin.

    if [[ -x "${BOOTSOURCEDIR}/mk" ]]; then
        (
            cd "${BOOTSOURCEDIR}" || exit 1
            git submodule update --init --recursive
            ARCH=arm64 CROSS_COMPILE="${CROSS_COMPILE:-aarch64-linux-gnu-}" ./mk s7d_odroidc5 --disable-bl33z
        )
    fi

    if [[ -s "${BOOTSOURCEDIR}/build/u-boot.bin" ]]; then
        cp -v "${BOOTSOURCEDIR}/build/u-boot.bin" "${uboot_name}/u-boot.bin"
        return 0
    fi

    display_alert "ODROID-C5 FIP packaging did not produce build/u-boot.bin" "BL30 RTOS SDK setup still required" "wrn"
    return 1
}
